# Settings for docker compose (copy to .env next to docker-compose.yml). Never commit .env.

# Database
POSTGRES_DB=madare_emrooz
POSTGRES_USER=madare
POSTGRES_PASSWORD=change-this-database-password

# Signs access tokens, SMS-code hashes and partner QR links. Use 32+ random characters:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# SMS: "console" prints sign-in codes in `docker compose logs backend` (testing only);
# "kavenegar" sends real SMS with the Verify template below.
SMS_BACKEND=console
KAVENEGAR_API_KEY=
KAVENEGAR_OTP_TEMPLATE=madareemrooz-otp

# Public address of the site, used in the partner QR link, e.g. https://madaremrooz.ir
PUBLIC_BASE_URL=

# Phase 1: doctors see every mother. Phase 2: "assigned".
DOCTOR_PATIENT_SCOPE=all

# Proxies in front of the API: 1 = the web container's nginx. Add one per extra proxy.
TRUSTED_PROXY_COUNT=1

# Port of the staff web panel (and the API under /api) on this machine.
WEB_PORT=8080
# Port of the mothers' web app on this machine.
MOTHER_PORT=8081
GUNICORN_WORKERS=3
