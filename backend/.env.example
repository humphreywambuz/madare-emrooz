# Copy to .env (same folder) and fill in. .env is git-ignored: never commit it.
FLASK_APP=wsgi.py
SECRET_KEY=change-me
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/madare_emrooz
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/madare_emrooz_test
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# SMS for sign-in codes.
#   console   = print codes to the server log (development, nothing is sent)
#   kavenegar = send real SMS with the Kavenegar Verify template below
SMS_BACKEND=console
KAVENEGAR_API_KEY=
KAVENEGAR_OTP_TEMPLATE=madareemrooz-otp
